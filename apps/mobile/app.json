{
  "expo": {
    "name": "Halteres",
    "slug": "halteres",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "halteres",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.halteres.app",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Halteres reads recent workouts to pre-fill your log so you don't have to type everything twice.",
        "NSHealthUpdateUsageDescription": "Halteres can write your completed workouts to Apple Health if you opt in."
      }
    },
    "android": {
      "package": "ai.halteres.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0b0e"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#f97316"
        }
      ],
      "@kingstinct/react-native-healthkit"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "REPLACE_AFTER_eas_init" }
    }
  }
}
