{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3001" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://api-preview.halteres.ai" }
    },
    "production": {
      "channel": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.halteres.ai" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
